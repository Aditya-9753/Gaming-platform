# Application Settings
APP_NAME="Virtual Gaming Platform"
APP_ENV="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000
LOG_LEVEL="INFO"

# Database Configuration (PostgreSQL Async via asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/gaming_db"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="local-development-only-change-before-use"
POSTGRES_DB="gaming_db"

# Redis Configuration
REDIS_URL="redis://localhost:6379/0"
CRICKET_DATA_URL=""
CRICKET_DATA_API_KEY=""

# JWT Authentication (HS256)
JWT_SECRET="replace-with-a-unique-random-secret-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-a-different-random-secret-at-least-32-characters"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated list or JSON array)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Monitoring (Optional)
SENTRY_DSN=""

# Virtual Credits Rules (paise: 100 paise = 1 Virtual Credit)
INITIAL_FAUCET_CREDITS=10000

# Payments
# AES-256-GCM key (64 hex chars) encrypting payout bank accounts / UPI ids at rest.
# Required in production; generate with: python -c "import secrets; print(secrets.token_hex(32))"
PII_ENCRYPTION_KEY=""
# Provider webhooks (HMAC-SHA256): "provider:secret,provider2:secret"
PAYMENT_WEBHOOK_SECRETS=""
# Optional comma separated source IPs allowed to call /api/v1/payments/webhook/{provider}
PAYMENT_WEBHOOK_IPS=""
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# ---- Partner / affiliate platform (see AFFILIATE.md) ----
# HMAC-SHA256 secret the operator signs /api/v1/ingest/* calls with
AFFILIATE_INGEST_SECRET=""
AFFILIATE_INGEST_TOLERANCE_SECONDS=300
# Optional comma separated operator IPs allowed to call /api/v1/ingest/*
AFFILIATE_INGEST_IPS=""
# Rudra247 reports its own referred players' sign-ups / deposits / daily revenue
AFFILIATE_INTERNAL_OPERATOR=true
# Main site / partner portal URL for partner links and emails until a tracking domain is added (empty = first CORS origin)
AFFILIATE_PUBLIC_BASE_URL=""
# Salt for hashing visitor IPs (empty in production = derived from JWT_SECRET): python -c "import secrets; print(secrets.token_hex(32))"
AFFILIATE_IP_SALT=""
# Daily ECB reference FX rates (api.frankfurter.dev) used to convert deposits / revenue to USD
AFFILIATE_FX_AUTO_FETCH=true
# Reject partner passwords found in public breaches (HaveIBeenPwned range API, only a hash prefix is sent)
AFFILIATE_BREACH_CHECK=true
# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile). With both keys: captcha after 5 failed
# sign-ins, 15-minute lock after 10. Without keys: lock after 5 failed sign-ins.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
